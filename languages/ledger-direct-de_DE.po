#: includes/views/ledger-direct_html.php:282
#, php-format
msgid "Only %s from exactly this issuer is credited. Your wallet needs a trust line for it."
msgstr "Nur %s genau dieses Herausgebers wird angerechnet. Ihre Wallet braucht dafür eine Trustline."

#: includes/views/ledger-direct_html.php:297
msgid "Paying from an exchange?"
msgstr "Zahlen Sie von einer Börse?"

#: includes/views/ledger-direct_html.php:298
msgid "The destination tag is required, and the amount must still arrive in full after the exchange's fee."
msgstr "Der Destination Tag ist Pflicht, und der Betrag muss nach Abzug der Börsengebühr noch vollständig ankommen."

#: includes/views/ledger-direct_html.php:302
msgid "Pay with a wallet"
msgstr "Mit Wallet bezahlen"

#: includes/views/ledger-direct_html.php:304
msgid "Show QR code ▾"
msgstr "QR-Code anzeigen ▾"

#: includes/views/ledger-direct_html.php:307
msgid "QR code with address, destination tag and amount"
msgstr "QR-Code mit Adresse, Destination Tag und Betrag"

#: includes/views/ledger-direct_html.php:308
msgid "Expired – please request a new amount"
msgstr "Abgelaufen – bitte neuen Betrag anfordern"

#: includes/views/ledger-direct_html.php:310
msgid "Scan with Xaman. Address, destination tag and amount are filled in, and Xaman offers to switch to the Xahau network if it is set to another one – please check them before sending."
msgstr "Mit Xaman scannen. Adresse, Destination Tag und Betrag sind vorausgefüllt, und Xaman bietet den Wechsel ins Xahau-Netzwerk an, falls ein anderes eingestellt ist – bitte vor dem Senden prüfen."

#: includes/views/ledger-direct_html.php:315
msgid "or"
msgstr "oder"

#: includes/views/ledger-direct_html.php:323
msgid "Pay with a browser wallet"
msgstr "Mit Browser-Wallet bezahlen"

#: includes/views/ledger-direct_html.php:326
msgid "Looking for wallets …"
msgstr "Wallets werden gesucht …"

#: includes/views/ledger-direct_html.php:328
