msgid "Confirm in your wallet …"
msgstr "Confirme na sua carteira …"

#: includes/views/ledger-direct_html.php:322
msgid "Sent – we are checking for it."
msgstr "Enviado – estamos a verificar a receção."

#: includes/views/ledger-direct_html.php:323
msgid "The wallet does not respond. Is the extension installed and unlocked?"
msgstr "A carteira não responde. A extensão está instalada e desbloqueada?"

#: includes/views/ledger-direct_html.php:324
msgid "The connection to the wallet failed – please try again."
msgstr "A ligação à carteira falhou – tente novamente."

