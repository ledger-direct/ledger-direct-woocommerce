msgstr "O destination tag é obrigatório e o montante tem de chegar na totalidade depois da comissão da corretora."

#: includes/views/ledger-direct_html.php:290
msgid "Pay with a wallet"
msgstr "Pagar com uma carteira"

#: includes/views/ledger-direct_html.php:292
msgid "Scan with a wallet app"
msgstr "Digitalizar com uma aplicação de carteira"

#: includes/views/ledger-direct_html.php:292
