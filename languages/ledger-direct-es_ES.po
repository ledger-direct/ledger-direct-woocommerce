#: src/Woocommerce/LedgerDirectPaymentGateway.php:55
msgid "Accept payments (XRP, RLUSD, USDC) on your XRPL wallet, and XAH on Xahau"
msgstr "Acepte pagos (XRP, RLUSD, USDC) en su cartera XRPL, y XAH en Xahau"

#: src/Woocommerce/LedgerDirectPaymentGateway.php:56
msgid "Pay directly on XRPL with LedgerDirect"
msgstr "Pagar directamente en el XRPL con LedgerDirect"

#: src/Woocommerce/LedgerDirectPaymentGateway.php:57
msgid "Choose your preferred XRPL payment method"
msgstr "Elija su método de pago XRPL preferido"

#. translators: %s: the value the merchant entered
#: src/Woocommerce/LedgerDirectPaymentGateway.php:152
#, php-format
msgid "\"%s\" is not a Xahau account address. It starts with r, like an XRP Ledger address; the previous value was kept."
msgstr "«%s» no es una dirección de cuenta de Xahau. Empieza por r, como una dirección del XRP Ledger; se ha conservado el valor anterior."

#. translators: %s: the account address
#: src/Woocommerce/LedgerDirectPaymentGateway.php:182
#, php-format
msgid "The Xahau account %s is also the XRP Ledger account on this network. The two are different accounts on different chains; use one account per chain."
msgstr "La cuenta de Xahau %s es también la cuenta del XRP Ledger en esta red. Son dos cuentas distintas en blockchains diferentes; utilice una cuenta por blockchain."

#. translators: %s: the value the merchant entered
#: src/Woocommerce/LedgerDirectPaymentGateway.php:200
#, php-format
msgid "\"%s\" is not an XRPL address. An address starts with r and has 25 to 35 letters and digits; the previous value was kept."
msgstr "«%s» no es una dirección XRPL. Una dirección empieza por r y tiene de 25 a 35 letras y cifras; se ha conservado el valor anterior."

#: src/Woocommerce/LedgerDirectPaymentGateway.php:228
msgid "The accent colour must be a hex colour such as #1f5eff."
msgstr "El color de acento debe ser un color hexadecimal, como #1f5eff."

#: src/Woocommerce/LedgerDirectPaymentGateway.php:234
msgid "The accent colour is too light to carry white text (contrast below 4.5:1). Choose a darker colour."
msgstr "El color de acento es demasiado claro para texto blanco (contraste inferior a 4,5:1). Elija un color más oscuro."

#: src/Woocommerce/LedgerDirectPaymentGateway.php:261
msgid "The payment page picture must be an image from this site's media library, given as its attachment ID or URL."
msgstr "La imagen de la página de pago debe ser una imagen de la biblioteca de medios de este sitio, indicada por su ID de adjunto o su URL."

#: src/Woocommerce/LedgerDirectPaymentGateway.php:280
msgid "The XRPL wallet is not configured. Please contact the site administrator."
msgstr "La cartera XRPL no está configurada. Póngase en contacto con el administrador del sitio."

