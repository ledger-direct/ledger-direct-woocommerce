msgstr "Cuenta receptora en la Mainnet de Xahau"

#: includes/admin/class-ledger-direct-admin.php:85
msgid "Xahau Account - TESTNET"
msgstr "Cuenta Xahau – TESTNET"

#: includes/admin/class-ledger-direct-admin.php:87
