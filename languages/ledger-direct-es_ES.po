msgid "Title for LedgerDirect Payment Page"
msgstr "Título para la página de pago de LedgerDirect"

#: includes/admin/class-ledger-direct-admin.php:95
msgid "LedgerDirect PaymentPage"
msgstr "Página de pago de LedgerDirect"

#: includes/admin/class-ledger-direct-admin.php:99
msgid "XRP quote expiry"
msgstr "Validez de la cotización"

#: includes/admin/class-ledger-direct-admin.php:101
msgid "Validity of the quote in minutes"
msgstr "Validez de la cotización en minutos"

#: includes/admin/class-ledger-direct-admin.php:106
msgid "Payment page: logo"
msgstr "Página de pago: logotipo"

#: includes/admin/class-ledger-direct-admin.php:109
msgid "The site logo"
msgstr "El logotipo del sitio"

#: includes/admin/class-ledger-direct-admin.php:110
msgid "A picture from the media library"
msgstr "Una imagen de la biblioteca de medios"

#: includes/admin/class-ledger-direct-admin.php:111
msgid "No logo, the first letter of the site name"
msgstr "Sin logotipo, la primera letra del nombre del sitio"

#: includes/admin/class-ledger-direct-admin.php:114
msgid "Shown in the header of the payment page, at most 160 by 32 pixels."
msgstr "Se muestra en la cabecera de la página de pago, como máximo 160 × 32 píxeles."

#: includes/admin/class-ledger-direct-admin.php:118
msgid "Payment page: picture"
msgstr "Página de pago: imagen"

#: includes/admin/class-ledger-direct-admin.php:120
msgid "The attachment ID or the URL of a picture in this site's media library. Only used with \"A picture from the media library\"."
msgstr "El ID del adjunto o la URL de una imagen de la biblioteca de medios de este sitio. Solo se usa con «Una imagen de la biblioteca de medios»."

#: includes/admin/class-ledger-direct-admin.php:125
msgid "Payment page: accent colour"
msgstr "Página de pago: color de acento"

#: includes/admin/class-ledger-direct-admin.php:127
msgid "Buttons, the countdown bar and the destination tag are drawn in this colour with white text on it, so it has to be dark enough (contrast 4.5:1). Default #1f5eff."
msgstr "Los botones, la barra de cuenta atrás y el destination tag se muestran en este color con texto blanco, por lo que debe ser lo bastante oscuro (contraste 4,5:1). Predeterminado #1f5eff."

#: includes/admin/class-ledger-direct-admin.php:132
msgid "Payment page: Xaman API key"
msgstr "Página de pago: clave API de Xaman"

#: includes/admin/class-ledger-direct-admin.php:134
msgid "The public API key of your Xaman developer app (apps.xaman.dev). With it, customers on a phone get an \"Open in wallet app\" button. Never the API secret."
msgstr "La clave API pública de su aplicación de desarrollador de Xaman (apps.xaman.dev). Con ella, los clientes en un móvil ven un botón \"Abrir en la aplicación de cartera\". Nunca el secreto de la API."

#: includes/admin/class-ledger-direct-admin.php:139
msgid "Payment page: WalletConnect project id"
msgstr "Página de pago: ID de proyecto de WalletConnect"

#: includes/admin/class-ledger-direct-admin.php:141
msgid "The project id from cloud.walletconnect.com, if you want to offer WalletConnect wallets. Public, like the Xaman key."
msgstr "El ID de proyecto de cloud.walletconnect.com, si desea ofrecer carteras WalletConnect. Público, como la clave de Xaman."

#. translators: 1: chain name, e.g. XRP Ledger, 2: account address, 3: network (mainnet or testnet)
#: includes/admin/class-ledger-direct-admin.php:186
#, php-format
msgid "%1$s: the receiving account %2$s on the %3$s can take every asset that is switched on."
msgstr "%1$s: la cuenta receptora %2$s en la red %3$s puede recibir todos los activos activados."

#. translators: 1: base reserve, e.g. 1, 2: native asset, e.g. XRP
#: includes/admin/class-ledger-direct-admin.php:206
#, php-format
msgid "The account is not activated yet. A first payment of at least %1$s %2$s activates it; until then smaller orders in %2$s fail, and tokens are not offered."
msgstr "La cuenta aún no está activada. Un primer pago de al menos %1$s %2$s la activa; hasta entonces fallan los pedidos menores en %2$s y no se ofrecen tokens."

#: includes/admin/class-ledger-direct-admin.php:208
msgid "Deposit authorization is set on the account: only senders you authorized can pay. The payment methods stay in the checkout."
msgstr "La cuenta tiene activada Deposit Authorization: solo pueden pagar los remitentes que usted autorizó. Los métodos de pago siguen disponibles en el pago."

#. translators: 1: asset, e.g. RLUSD, 2: issuer address
#: includes/admin/class-ledger-direct-admin.php:211
#, php-format
msgid "%1$s is not offered in the checkout: the account has no trustline to the issuer %2$s."
msgstr "%1$s no se ofrece en el pago: la cuenta no tiene trustline con el emisor %2$s."

#. translators: 1: asset, e.g. RLUSD, 2: issuer address
#: includes/admin/class-ledger-direct-admin.php:214
#, php-format
msgid "%1$s is not offered in the checkout: the issuer %2$s has not authorized the trustline."
msgstr "%1$s no se ofrece en el pago: el emisor %2$s no ha autorizado la trustline."

#. translators: %s: asset, e.g. RLUSD
#: includes/admin/class-ledger-direct-admin.php:217
#, php-format
msgid "%s is not offered in the checkout: the trustline is frozen."
msgstr "%s no se ofrece en el pago: la trustline está congelada."

#. translators: %s: asset, e.g. RLUSD
#: includes/admin/class-ledger-direct-admin.php:220
#, php-format
msgid "%s is not offered in the checkout: the trustline has reached its limit."
msgstr "%s no se ofrece en el pago: la trustline ha alcanzado su límite."

#. translators: 1: asset, e.g. RLUSD, 2: issuer address
#: includes/admin/class-ledger-direct-admin.php:223
#, php-format
msgid "%1$s is not offered in the checkout: the issuer %2$s has frozen all its trustlines."
msgstr "%1$s no se ofrece en el pago: el emisor %2$s ha congelado todas sus trustlines."

#. translators: %s: native asset, e.g. XRP
#: includes/admin/class-ledger-direct-admin.php:226
#, php-format
msgid "The ledger could not be asked just now. Until it can, tokens are not offered; %s is."
msgstr "No se pudo consultar el ledger en este momento. Hasta entonces no se ofrecen tokens; %s sí."

