<?xml version="1.0"?>
<phpunit
        bootstrap="tests/bootstrap.php"
        colors="true"
        stopOnFailure="false"
        displayDetailsOnTestsThatTriggerWarnings="true"
>
  <!-- Needs network access and the XRPL testnet faucet; run explicitly by passing the phpunit group option with external-http -->
  <groups>
    <exclude>
      <group>external-http</group>
    </exclude>
  </groups>
  <testsuites>
    <testsuite name="tests">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
</phpunit>