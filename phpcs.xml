<?xml version="1.0"?>
<ruleset name="LedgerDirect">
    <description>
        WordPress Coding Standards ruleset for the LedgerDirect plugin, scoped to
        security/correctness sniffs (escaping, sanitization, nonces, prepared SQL,
        i18n, discouraged functions). The codebase follows PSR-style formatting
        (camelCase, spaces, PSR-4 autoloading) rather than WordPress' own style
        conventions, so purely stylistic/naming sniffs are excluded - otherwise
        this gate would flag the entire pre-existing codebase instead of real issues.
    </description>

    <file>ledger-direct.php</file>
    <file>includes</file>
    <file>src</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_supported_wp_version" value="6.7"/>

    <!--
        Warnings (redirect hardening, error_log() usage, missing asset versions, etc.) are
        intentionally left as non-blocking findings rather than fixed or excluded outright -
        without this, phpcs exits 2 on warnings alone and fails CI even with zero errors.
    -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.PHP.YodaConditions"/>
        <exclude name="WordPress.WhiteSpace"/>
        <exclude name="WordPress.Arrays"/>
        <exclude name="WordPress.NamingConventions"/>
        <exclude name="Generic.WhiteSpace"/>
        <exclude name="Generic.Formatting"/>
        <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie"/>
        <exclude name="Generic.Commenting"/>
        <exclude name="Generic.Classes.OpeningBraceSameLine"/>
        <exclude name="Generic.ControlStructures.InlineControlStructure"/>
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="PEAR.Functions.FunctionCallSignature"/>
        <exclude name="PSR2.Files.EndFileNewline"/>
        <exclude name="PSR2.Classes"/>
        <exclude name="PSR12.Functions.ReturnTypeDeclaration"/>
        <exclude name="PSR12.Files.FileHeader"/>
        <exclude name="Squiz.Commenting"/>
        <exclude name="Squiz.ControlStructures.ControlSignature"/>
        <exclude name="Squiz.PHP.DisallowMultipleAssignments"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
        <exclude name="Squiz.Strings.DoubleQuoteUsage"/>
        <exclude name="Squiz.Strings.ConcatenationSpacing"/>
        <exclude name="Squiz.WhiteSpace"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.WhiteSpace"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <exclude name="Universal.NamingConventions"/>
        <exclude name="Universal.UseStatements"/>
        <exclude name="NormalizedArrays"/>
        <!--
            Custom, non-post tables (ledger_direct_xrpl_tx / ledger_direct_xrpl_destination_tag)
            require $wpdb queries that WP_Query/get_posts can never cover - excluded rather than
            chasing an inapplicable sniff across every query in install.php/XrplTxService.
            The interpolated {$table}/{$wpdb->prefix} values the sniff also flags are always
            internal literals built from $wpdb->prefix plus a fixed table name, never user input;
            actual user-supplied values in those same queries are still passed through
            $wpdb->prepare() placeholders.
        -->
        <exclude name="WordPress.DB.DirectDatabaseQuery"/>
        <exclude name="WordPress.DB.PreparedSQL"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ledger-direct"/>
            </property>
        </properties>
    </rule>
</ruleset>
