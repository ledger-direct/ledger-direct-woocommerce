{
  "name": "hardcastle/ledger-direct-woocommerce",
  "type": "project",
  "description": "XRP Ledger integration",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "hardcastle/ledger-direct-core": "^0.4",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "10up/wp_mock": "^0.4.2",
    "brain/monkey": "^2.6",
    "phpstan/phpstan": "^1.10",
    "php-stubs/wordpress-tests-stubs": "^6.1",
    "yoast/phpunit-polyfills": "^2.0",
    "mockery/mockery": "^1.6",
    "wp-coding-standards/wpcs": "^3.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "php-stubs/wordpress-stubs": "^6.9",
    "php-stubs/woocommerce-stubs": "^11.0",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Hardcastle\\LedgerDirect\\": "src/",
      "Hardcastle\\LedgerDirect\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Alexander Busse",
      "email": "dev@ledger-direct.com"
    }
  ],
  "keywords": [
    "ledger",
    "direct",
    "xrp",
    "xrpl",
    "rlusd",
    "stablecoin",
    "ripple",
    "gemwallet",
    "crossmark",
    "xumm"
  ],
  "homepage": "https://www.ledger-direct.com/",
  "scripts": {
    "phpcs": "phpcs -s -p",
    "phpstan": "phpstan",
    "test": "phpunit -c phpunit.xml"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
